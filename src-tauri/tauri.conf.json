{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Agent Desktop",
  "version": "2.2.2",
  "identifier": "com.gitagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Git Agent Desktop",
        "width": 1120,
        "height": 700,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#0b0e14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Git Agent Desktop",
    "category": "DeveloperTool",
    "shortDescription": "Automatizacion agentica de Pull Requests",
    "longDescription": "Cliente de escritorio que automatiza la inspeccion de codigo, la edicion atomica y la publicacion de Pull Requests con aprobacion humana obligatoria.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  }
}
